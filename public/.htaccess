# SPA fallback — send unknown routes to index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{HTTP:Accept} text/markdown [OR]
  RewriteCond %{HTTP_USER_AGENT} ^(curl|wget)/|ChatGPT-User|Claude-User|Perplexity-User [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ /index.md [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

AddType application/manifest+json .webmanifest
AddType "text/markdown; charset=utf-8" .md

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml font/woff font/woff2
</IfModule>

# Long cache for fingerprinted Vite assets
<IfModule mod_headers.c>
  <FilesMatch "\.(?:js|css|woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Static media — 30 days
  <FilesMatch "\.(?:png|jpg|jpeg|gif|webp|avif|svg|ico|wav|mp3|m4a|ogg|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML must always revalidate so deploys go live
  <FilesMatch "\.(?:html|md)$">
    Header set Cache-Control "no-cache"
    Header append Vary "Accept, User-Agent"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Link '</index.md>; rel="alternate"; type="text/markdown"'
  </FilesMatch>

  # Same for the service worker and the manifest, or the installed app stops getting updates
  <FilesMatch "^(?:sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
    Header unset Expires
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                    "access plus 1 year"
  ExpiresByType application/javascript      "access plus 1 year"
  ExpiresByType font/woff2                  "access plus 1 year"
  ExpiresByType image/webp                  "access plus 30 days"
  ExpiresByType image/png                   "access plus 30 days"
  ExpiresByType image/svg+xml               "access plus 30 days"
  ExpiresByType audio/wav                   "access plus 30 days"
  ExpiresByType audio/mpeg                  "access plus 30 days"
  ExpiresByType text/html                   "access plus 0 seconds"
</IfModule>
