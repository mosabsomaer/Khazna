{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM"],
		"types": ["bun"],
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true
	},
	"include": ["scripts", "test"]
}
