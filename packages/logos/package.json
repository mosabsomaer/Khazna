{
	"name": "@khazna/logos",
	"version": "0.1.0",
	"description": "Libyan bank, payment method and payment gateway logos as SVG files, typed metadata and React components.",
	"keywords": [
		"libya",
		"logos",
		"banks",
		"payments",
		"svg",
		"react"
	],
	"license": "MIT",
	"homepage": "https://khazna.ly",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mosabsomaer/Khazna.git",
		"directory": "packages/logos"
	},
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./react": {
			"types": "./dist/react/index.d.ts",
			"default": "./dist/react/index.js"
		},
		"./svg/*": "./dist/svg/*",
		"./package.json": "./package.json"
	},
	"typesVersions": {
		"*": {
			"react": [
				"./dist/react/index.d.ts"
			]
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "bun scripts/build.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test --timeout 30000",
		"prepack": "bun scripts/build.ts"
	},
	"peerDependencies": {
		"react": ">=18"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/bun": "^1.3.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"typescript": "~5.8.2"
	}
}
